{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [
    { "source": "/pourquoi", "destination": "/index.html" },
    { "source": "/methodologie", "destination": "/index.html" },
    { "source": "/a-propos", "destination": "/index.html" },
    { "source": "/decklists-publiques", "destination": "/index.html" },
    { "source": "/decklists-publiques/:path*", "destination": "/index.html" },
    { "source": "/a/:path*", "destination": "/index.html" },
    { "source": "/pod", "destination": "/index.html" },
    { "source": "/match", "destination": "/index.html" }
  ]
}
